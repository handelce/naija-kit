{
  "name": "naija-kit",
  "version": "0.0.2",
  "description": "Nigerian developer utilities: NUBAN and bank codes, phone numbers, states, Naira formatting. Zero dependencies.",
  "license": "MIT",
  "author": "Handel Emezue (https://github.com/handelce)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handelce/naija-kit.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/handelce/naija-kit#readme",
  "bugs": {
    "url": "https://github.com/handelce/naija-kit/issues"
  },
  "keywords": [
    "nigeria",
    "nigerian",
    "naija",
    "nuban",
    "naira",
    "phone",
    "banks",
    "states",
    "validation"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./banks": {
      "import": {
        "types": "./dist/banks.d.ts",
        "default": "./dist/banks.js"
      },
      "require": {
        "types": "./dist/banks.d.cts",
        "default": "./dist/banks.cjs"
      }
    },
    "./nuban": {
      "import": {
        "types": "./dist/nuban.d.ts",
        "default": "./dist/nuban.js"
      },
      "require": {
        "types": "./dist/nuban.d.cts",
        "default": "./dist/nuban.cjs"
      }
    },
    "./phone": {
      "import": {
        "types": "./dist/phone.d.ts",
        "default": "./dist/phone.js"
      },
      "require": {
        "types": "./dist/phone.d.cts",
        "default": "./dist/phone.cjs"
      }
    },
    "./naira": {
      "import": {
        "types": "./dist/naira.d.ts",
        "default": "./dist/naira.js"
      },
      "require": {
        "types": "./dist/naira.d.cts",
        "default": "./dist/naira.cjs"
      }
    },
    "./geo": {
      "import": {
        "types": "./dist/geo.d.ts",
        "default": "./dist/geo.js"
      },
      "require": {
        "types": "./dist/geo.d.cts",
        "default": "./dist/geo.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/banks.ts src/nuban.ts src/phone.ts src/naira.ts src/geo.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/prepare-package-files.mjs",
    "prepublishOnly": "npm run build && npm test && node ../../scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
